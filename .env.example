# Data directory (SQLite + memory + transcripts)
DATA_DIR=./data

# HTTP ingress
PORT=8787
HOST=127.0.0.1

# Optional webhook HMAC (hex or raw string)
WEBHOOK_SECRET=

# Optional Anthropic API key — without it, the deterministic mock brain is used
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Budgets
MAX_TURNS_PER_RUN=12
MAX_TOKENS_PER_RUN=8000
MAX_WALL_MS_PER_RUN=120000
MAX_RUNS_PER_DAY=200

# Scheduler / dispatcher cadence (ms)
SCHEDULER_INTERVAL_MS=5000
DISPATCHER_INTERVAL_MS=2000
WORKER_IDLE_MS=1500

# Approval channel shared secret (required for /events/approval)
APPROVAL_SECRET=dev-approval-secret

# Minimum follow-up interval (seconds)
MIN_FOLLOWUP_SECONDS=60
MAX_ACTIVE_FOLLOWUPS=20
