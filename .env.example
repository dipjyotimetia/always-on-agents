# Data directory (SQLite + memory + transcripts)
DATA_DIR=./data

# HTTP ingress
PORT=8787
HOST=127.0.0.1
MAX_BODY_BYTES=256000
RATE_LIMIT_PER_MINUTE=120

# Webhook HMAC (hex digest of raw body). Set REQUIRE_WEBHOOK_SECRET=true in prod.
WEBHOOK_SECRET=
REQUIRE_WEBHOOK_SECRET=false

# Brain selection: auto | mock | anthropic | openai | gemini
# auto uses Anthropic, then OpenAI, then Gemini, and otherwise the offline mock.
# An explicit brain fails at startup when its API key is missing.
# Live calls go through the official SDKs (@anthropic-ai/sdk, openai, @google/genai).
BRAIN=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1

# GEMINI_API_KEY falls back to GOOGLE_API_KEY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=

# Approval channel shared secret (required for /events/approval)
APPROVAL_SECRET=dev-approval-secret

# Credentials for the proxy (never exposed to the agent). Example:
# AOA_SECRET_EXTERNAL_MAIL=...
# AOA_SECRET_API=...

# Budgets
MAX_TURNS_PER_RUN=12
MAX_TOKENS_PER_RUN=8000
MAX_WALL_MS_PER_RUN=120000
MAX_RUNS_PER_DAY=200
MAX_TOKENS_PER_DAY=500000
EVENT_MAX_ATTEMPTS=3

# Session compaction
SESSION_MAX_MESSAGES=40
SESSION_KEEP_RECENT=12

# Scheduler / dispatcher cadence (ms)
SCHEDULER_INTERVAL_MS=5000
DISPATCHER_INTERVAL_MS=2000
WORKER_IDLE_MS=1500
LEASE_TTL_MS=30000

# Follow-ups
MIN_FOLLOWUP_SECONDS=60
MAX_ACTIVE_FOLLOWUPS=20

# Quiet by default: bare assistant text is NOT auto-notified
AUTO_NOTIFY_BARE_TEXT=false

# Lightweight ops dashboard at http://HOST:PORT/ui (set false to disable)
ENABLE_UI=true
